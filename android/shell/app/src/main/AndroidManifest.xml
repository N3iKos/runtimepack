<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions are generated dynamically based on declared runtime capabilities -->
    <!-- Broad storage permissions (MANAGE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE) are strictly forbidden -->
    <!-- {{PERMISSIONS}} -->

    <application
        android:name="io.runtimepack.host.RuntimeApplication"
        android:allowBackup="true"
        android:label="RuntimePack"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="io.runtimepack.host.BootstrapActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
