{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompatibilityReport",
  "description": "Schema for compatibility-report.json",
  "type": "object",
  "required": [
    "schema_version",
    "engine_id",
    "status",
    "confidence",
    "score",
    "evidence",
    "issues"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "engine_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "COMPATIBLE",
        "COMPATIBLE_WITH_SHIMS",
        "DEGRADED",
        "UNSUPPORTED_DEPENDENCY",
        "UNKNOWN",
        "BLOCKED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["EXACT", "HIGH", "MEDIUM", "LOW", "NONE", "AMBIGUOUS"]
    },
    "score": { "type": "integer" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "path", "weight"],
        "properties": {
          "rule": { "type": "string" },
          "path": { "type": "string" },
          "weight": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string" },
          "source_path": { "type": ["string", "null"] },
          "remediation": { "type": ["string", "null"] }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_shims": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
